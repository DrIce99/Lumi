{
  "name": "lumi",
  "productName": "Lumi",
  "version": "0.1.0",
  "description": "Assistente vocale da scrivania: due occhi che ti ascoltano, ti rispondono a voce e guardano lo schermo",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build.mjs --tests && node --test \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm test",
    "start": "node build.mjs && node run.mjs",
    "debug": "node build.mjs && node run.mjs --debug",
    "dist": "node build.mjs && node scripts/prepare-dist.mjs && electron-builder --win nsis --x64",
    "dist:dir": "node build.mjs && node scripts/prepare-dist.mjs && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "koffi": "^3.3.3",
    "opusscript": "^0.1.1",
    "qrcode": "1.5.4",
    "sqlite-vec": "0.1.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "app.lumi.desktop",
    "productName": "Lumi",
    "copyright": "Lumi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "!dist/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sqlite-vec*/**"
    ],
    "extraResources": [
      {
        "from": "../sidecar",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!tests/**",
          "!.pytest_cache/**",
          "!scripts/**",
          "!lora/**",
          "!*.egg-info/**"
        ]
      },
      {
        "from": "build/uv",
        "to": "uv",
        "filter": [
          "uv.exe"
        ]
      },
      {
        "from": "../phone/www",
        "to": "phone/www"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Lumi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumi",
      "uninstallDisplayName": "Lumi",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "include": "build/installer.nsh"
    }
  },
  "author": "DrIce99"
}
